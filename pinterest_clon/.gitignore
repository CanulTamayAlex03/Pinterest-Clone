app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Añadidos importantes para iOS
**/ios/Podfile.lock  # Añadido - archivo de dependencias de CocoaPods
**/ios/Pods/  # Añadido - dependencias de iOS
**/ios/.generated/  # Añadido - archivos generados
**/ios/DerivedData/  # Añadido - datos derivados de Xcode

# Añadidos para Android
**/android/.gradle/  # Añadido - caché de Gradle
**/android/local.properties  # Añadido - contiene paths locales
**/android/gradlew.bat  # Añadido - se regeneran
**/android/gradlew  # Añadido - se regeneran

# Archivos de entorno
*.env  # Añadido - archivos de entorno
.env.local  # Añadido
.env.*.local  # Añadido

# Archivos específicos de usuario
*.swp  # Añadido
*.swo  # Añadido
